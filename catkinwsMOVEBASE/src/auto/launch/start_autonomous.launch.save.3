<launch>
  <!-- ===================== Static Transforms ===================== -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_imu_broadcaster"
        args="0 0 0 0 0 0 base_link imu_link 100" />
  <node pkg="tf" type="static_transform_publisher" name="base_to_compass_broadcaster"
        args="0 0 0 0 0 0 base_link compass_link 100" />
  <node pkg="tf" type="static_transform_publisher" name="base_to_gps_broadcaster"
        args="0 0 0 0 0 0 base_link gps_link 100" />
  <!-- Placeholder for future ultrasonic sensor transform -->
  <!--
  <node pkg="tf" type="static_transform_publisher" name="base_to_ultrasonic_broadcaster"
        args="0 0 0.1 0 0 0 base_link ultrasonic_link 100" />
  -->

  <!-- ===================== Wheel Encoder Node ===================== -->
  <node pkg="wheel_encoders" type="wheel_encoder_node.py" name="wheel_encoder_node" output="screen">
    <param name="left_encoder_pin" value="11" />
    <param name="right_encoder_pin" value="16" />
    <param name="rate" value="20" />
  </node>

  <!-- ===================== EKF Localization ===================== -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization_node">
    <rosparam command="load" file="$(find auto)/config/ekf.yaml" />
  </node>

  <!-- ===================== Navsat Transform ===================== -->
  <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform_node" respawn="true">
    <param name="datum_latitude" value="26.2307901667" />
    <param name="datum_longitude" value="78.2061421667" />
    <param name="datum_yaw" value="0.0" />
    <!-- <param name="utm_zone" value="44" /> -->
    <!-- <param name="utm_zone_override" value="true" /> -->
    <param name="use_manual_datum" value="true" />
    <param name="debug" value="true" />
    <param name="publish_filtered_gps" value="true" />
    <param name="use_odometry_yaw" value="false" />
    <param name="wait_for_datum" value="false" />
    <param name="broadcast_utm_transform" value="true" />
    <param name="transform_timeout" value="2.0" />
    <param name="magnetic_declination_radians" value="0.0" />
    <param name="yaw_offset" value="0.0" />
    <param name="zero_altitude" value="true" />
    <param name="map_frame" value="map" />
    <param name="odom_frame" value="odom" />
    <remap from="/imu/data" to="/imu/data" />
    <remap from="/gps/fix" to="/fix" />
    <remap from="/odometry/filtered" to="/odometry/filtered" />
  </node>

  <!-- ===================== Sensor Nodes ===================== -->
  <node pkg="compass_reader" type="neo7mgps_calib.py" name="gps_node" args="gps" />
  <node pkg="compass_reader" type="neo7mgps_calib.py" name="compass_node" args="compass">
    <param name="x_offset" value="-33.50" />
    <param name="y_offset" value="247.50" />
  </node>
  <node pkg="mpu6050" type="mpu6050_calib.py" name="mpu6050_node" />

    <node pkg="auto" type="diff_drive_controller.py" name="diff_drive_controller" output="screen">
        <param name="wheel_separation" value="0.365" />
            <param name="ticks_per_meter" value="1000" />
                <param name="max_speed" value="0.6" />
                    <param name="rate" value="50" />
                        <param name="timeout" value="0.2" />
                            <param name="Kp" value="10.0" />
                                <param name="Ki" value="10.0" />
                                    <param name="Kd" value="0.001" />
                                        <param name="out_min" value="-1000" />
                                            <param name="out_max" value="1000" />
                                                <param name="right_motor_trim" value="1.34" />
                                                    <remap from="~cmd_vel" to="/cmd_vel" />
                                                      </node>
  <!-- ===================== Waypoint to Move Base ===================== -->
  <node pkg="auto" type="waypoint_to_move_base.py" name="waypoint_to_move_base" output="screen" />

  <!-- ===================== Move Base ===================== -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find auto)/config/move_base_params.yaml" command="load" />
    <rosparam file="$(find auto)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find auto)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find auto)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find auto)/config/local_costmap_params.yaml" command="load" />
    <remap from="/odom" to="/odometry/filtered" />
    <remap from="/cmd_vel" to="/cmd_vel" />
  </node>

  <!-- ===================== Motor Control ===================== -->
  <node pkg="motorcontrol" type="motorcontrolassembled.py" name="software_pwm_driver" output="screen" />
</launch>
