<launch>
  <!-- Static transforms - MUST come first -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_imu_broadcaster"
        args="0 0 0 0 0 0 base_link imu_link 100" />
        
  <node pkg="tf" type="static_transform_publisher" name="base_to_compass_broadcaster"
        args="0 0 0 0 0 0 base_link compass_link 100" />
        
  <node pkg="tf" type="static_transform_publisher" name="base_to_gps_broadcaster"
        args="0 0 0 0 0 0 base_link gps_link 100" />

  <!-- EKF Localization Node - Creates odom->base_link transform -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization_node">
    <rosparam command="load" file="$(find auto)/config/ekf.yaml"/>
  </node>

  <!-- Navsat Transform Node - Creates map->odom transform -->
  <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform_node" respawn="true">
    <param name="datum_latitude" value="2611.72546"/>
    <param name="datum_longitude" value="07810.72247"/>
    <param name="datum_yaw" value="0.0"/>
    
    <!-- Topic remappings -->
    <remap from="/imu/data" to="/imu/data"/>
    <remap from="/gps/fix" to="/fix"/>
    <remap from="/odometry/filtered" to="/odometry/filtered"/>
    
    <!-- Important parameters -->
    <param name="debug" value="false"/>
    <param name="publish_filtered_gps" value="true"/>
    <param name="use_odometry_yaw" value="false"/>
    <param name="wait_for_datum" value="false"/>
    <param name="broadcast_utm_transform" value="false"/>
    <param name="transform_timeout" value="0.1"/>
    <param name="magnetic_declination_radians" value="0.0"/>
    <param name="yaw_offset" value="0.0"/>
    <param name="zero_altitude" value="true"/>
  </node>

  <!-- Sensor Nodes -->
  <node pkg="compass_reader" type="neo7mgps_calib.py" name="gps_node" args="gps"/>

  <node pkg="compass_reader" type="neo7mgps_calib.py" name="compass_node" args="compass">
    <param name="x_offset" value="-45"/>
    <param name="y_offset" value="318"/>
  </node>

  <node pkg="mpu6050" type="mpu6050_calib.py" name="mpu6050_node"/>

  <!-- Navigation and Control Nodes -->
  <node pkg="auto" type="waypoint_follower.py" name="waypoint_follower" output="screen"/>

  <node pkg="auto" type="diff_drive_controller.py" name="diff_drive_controller" output="screen"/>

  <node pkg="motorcontrol" type="motorcontrolassembled.py" name="software_pwm_driver" output="screen"/>

</launch>
