{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# 🛫 FOD Detection - YOLOv8 Training Pipeline\n",
        "\n",
        "This notebook is optimized for training a YOLOv8 model on a local Foreign Object Debris (FOD) dataset consisting of PNG images."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Install Ultralytics and dependencies\n",
        "!pip install ultralytics -q\n",
        "!pip install opencv-python -q\n",
        "!pip install pyyaml -q"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "import yaml\n",
        "import logging\n",
        "import cv2\n",
        "from ultralytics import YOLO\n",
        "\n",
        "logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def create_fod_yaml(root_path, nc, names):\n",
        "    \"\"\"Creates a data.yaml file required for YOLO training.\"\"\"\n",
        "    data_yaml = {\n",
        "        'path': os.path.abspath(root_path),\n",
        "        'train': 'train/images',\n",
        "        'val': 'val/images',\n",
        "        'nc': nc,\n",
        "        'names': names\n",
        "    }\n",
        "    yaml_path = os.path.join(root_path, 'fod_data.yaml')\n",
        "    with open(yaml_path, 'w') as f:\n",
        "        yaml.dump(data_yaml, f, default_flow_style=False)\n",
        "    logging.info(f\"YAML config created at: {yaml_path}\")\n",
        "    return yaml_path\n",
        "\n",
        "def start_fod_training(yaml_path, config):\n",
        "    \"\"\"Initializes and starts YOLOv8 training.\"\"\"\n",
        "    model = YOLO(config['base_model'])\n",
        "    model.train(\n",
        "        data=yaml_path,\n",
        "        epochs=config['epochs'],\n",
        "        imgsz=config['imgsz'],\n",
        "        batch=config['batch'],\n",
        "        device=config['device'],\n",
        "        project=config['project'],\n",
        "        name=config['name'],\n",
        "        exist_ok=True\n",
        "    )\n",
        "    return model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- ⚙️ CONFIGURATION ---\n",
        "FOD_DATASET_ROOT = 'visionEdge/fod_data'  # Path to your folder containing train/val\n",
        "\n",
        "train_config = {\n",
        "    'base_model': 'yolov8m.pt',    # YOLOv8 medium (good balance of speed/accuracy)\n",
        "    'nc': 1,                      # Number of classes\n",
        "    'names': ['FOD'],             # Class names\n",
        "    'epochs': 50,                 # Recommended for FOD\n",
        "    'imgsz': 640,                 # Resolution\n",
        "    'batch': 16,                  # Adjust based on GPU memory\n",
        "    'device': '0',                # Use GPU '0'\n",
        "    'project': 'runs/train_fod',  \n",
        "    'name': 'fod_png_experiment'\n",
        "}"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# --- 🚀 RUN TRAINING ---\n",
        "if not os.path.exists(FOD_DATASET_ROOT):\n",
        "    logging.error(f\"Dataset not found at {FOD_DATASET_ROOT}. Check your path!\")\n",
        "else:\n",
        "    yaml_file = create_fod_yaml(FOD_DATASET_ROOT, train_config['nc'], train_config['names'])\n",
        "    trained_model = start_fod_training(yaml_file, train_config)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🔍 Inference\n",
        "Once training is done, test the model on new PNG images."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "test_image = 'path/to/your/test_image.png'  # Update this\n",
        "best_model_path = f\"{train_config['project']}/{train_config['name']}/weights/best.pt\"\n",
        "\n",
        "if os.path.exists(best_model_path):\n",
        "    model = YOLO(best_model_path)\n",
        "    results = model.predict(source=test_image, conf=0.25, save=True)\n",
        "    logging.info(f\"Inference complete. Results saved to {results[0].save_dir}\")\n",
        "else:\n",
        "    logging.warning(\"Model weights not found. Did training complete?\")"
      ]
    }
  ],\n",
